---
// src/layouts/Layout.astro
import "../styles/global.css";
import { ProductosApi } from "../api/services/productos/ProductosApi";
import { CategoriasApi } from "../api/services/categorias/CategoriasApi";
import { TiendasApi } from "../api/services/tiendas/TiendasApi";
import type { ProductoResponse } from "../api/types/productos/ProductoResponse";
import type { CategoriaResponse } from "../api/types/categorias/CategoriaResponse";
import type { TiendaResponse } from "../api/types/tiendas/TiendaResponse";

// Componentes de Estructura Global
import TopBanner from "../components/layout/TopBanner.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";

// Componentes de Overlays (Drawers y Modales)
import CartDrawer from "../components/overlays/CartDrawer.astro";
import WishlistDrawer from "../components/overlays/WishlistDrawer.astro";
import QuickViewModal from "../components/overlays/QuickViewModal.astro";
import OrderThanksModal from "../components/overlays/OrderThanksModal.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** true en el Home: el header inicia transparente sobre el Hero */
  heroHeader?: boolean;
}

const {
  title = "NOBLE MUSE — Tienda de Ropa, Calzado y Accesorios",
  description = "Catálogo multitienda de moda urbana, calzado, sneakers y accesorios.",
  ogImage,
  heroHeader = false,
} = Astro.props;

const productosApi = new ProductosApi();
const categoriasApi = new CategoriasApi();
const tiendasApi = new TiendasApi();

let rawProductos: ProductoResponse[] = [];
let rawCategorias: CategoriaResponse[] = [];
let rawTiendas: TiendaResponse[] = [];

try {
  [rawProductos, rawCategorias, rawTiendas] = await Promise.all([
    productosApi.getPrincipalesProductos(0, 50),
    categoriasApi.listCategorias(),
    tiendasApi.listTiendasActivas(),
  ]);
} catch (error) {
  console.error("Error al obtener datos en Layout:", error);
}

const CATS =
  rawTiendas.length > 0
    ? rawTiendas.map((t) => t.nombre)
    : Array.from(
        new Set(
          rawProductos.flatMap((p) =>
            (p.tiendas ?? []).map((t) => t.tiendaNombre)
          )
        )
      );

const mappedProducts = rawProductos.map((p) => {
  const imgPrincipal =
    p.imagenes?.find((im) => im.esPrincipal) ?? p.imagenes?.[0];
  const imgSecundaria =
    p.imagenes?.find((im) => im.id !== imgPrincipal?.id) ?? p.imagenes?.[1];
  const hasRange =
    p.precioMin !== undefined &&
    p.precioMax !== undefined &&
    p.precioMin !== p.precioMax;

  const tallas = p.talla
    ? p.talla
        .split(",")
        .map((s) => s.trim())
        .filter(Boolean)
    : ["ÚNICA"];

  return {
    id: p.id,
    handle: p.id,
    name: p.nombre,
    description: p.descripcion,
    talla: p.talla ?? "ÚNICA",
    price: p.precioMin ?? p.precio ?? 0,
    precioMin: p.precioMin ?? p.precio ?? 0,
    precioMax: p.precioMax ?? p.precio ?? 0,
    oldPrice: hasRange ? p.precioMax : null,
    image: imgPrincipal?.url ?? "",
    image2: imgSecundaria?.url ?? "",
    cat: p.tiendas?.[0]?.tiendaNombre ?? "Colección General",
    tiendas: p.tiendas ?? [],
    tiendasCount: p.tiendas?.length ?? 1,
    stockTotal: p.stockTotal ?? p.stock ?? 0,
    badge: hasRange ? "MULTITIENDA" : "EN STOCK",
    colors: [],
    sizes: tallas,
  };
});

const megaFeatured = mappedProducts[0];

const clientData = JSON.stringify({
  cats: CATS,
  products: mappedProducts,
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen overflow-x-hidden bg-base font-sans font-light text-ink"
    data-muse={clientData}
    data-hero-header={heroHeader ? "1" : ""}
  >
    <!-- 1. Cinta Superior y Barra de Navegación -->
    <TopBanner />
    <Navbar
      heroHeader={heroHeader}
      tiendas={rawTiendas}
      categorias={rawCategorias}
      megaFeatured={megaFeatured}
    />

    <!-- 2. Contenido de la Página -->
    <slot />

    <!-- 3. Pie de Página -->
    <Footer categorias={rawCategorias} tiendas={rawTiendas} />

    <!-- 4. Drawers, Modales y Notificaciones Globales -->
    <OrderThanksModal />
    <QuickViewModal />
    <CartDrawer />
    <WishlistDrawer />

    <script>
      import { initLayoutClient } from "../lib/layoutClient";
      initLayoutClient();
    </script>
  </body>
</html>

---
// src/layouts/AdminLayout.astro
import "../styles/global.css";

interface Props {
  title?: string;
  section?: "productos" | "categorias" | "tiendas" | "usuarios" | "ventas";
}

const {
  title = "Panel de Administración — NOBLE MUSE",
  section = "productos",
} = Astro.props;

const navLinks = [
  { id: "productos", label: "Productos & Stock", href: "/admin", note: "01" },
  {
    id: "categorias",
    label: "Categorías",
    href: "/admin/categorias",
    note: "02",
  },
  { id: "tiendas", label: "Sucursales", href: "/admin/tiendas", note: "03" },
  {
    id: "usuarios",
    label: "Usuarios & Roles",
    href: "/admin/usuarios",
    note: "04",
  },
  {
    id: "ventas",
    label: "Ventas & Reportes",
    href: "/admin/ventas",
    note: "05",
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-tint/35 font-sans font-light text-ink">
    <!-- ── Barra Superior Administrativa ── -->
    <header class="sticky top-0 z-[100] border-b border-line bg-[#191936] text-white">
      <div class="mx-auto flex h-16 max-w-[1640px] items-center justify-between px-5 lg:px-9">
        <div class="flex items-center gap-6">
          <a href="/admin" class="flex flex-col">
            <span class="text-[14px] font-normal tracking-[0.34em]">
              NOBLE MUSE · ADMIN
            </span>
            <span class="note text-acclite">
              CONSOLA CENTRAL MULTITIENDA
            </span>
          </a>
        </div>

        <div class="flex items-center gap-4 sm:gap-6">
          <div class="hidden items-center gap-2.5 sm:flex">
            <span
              id="admin-user-role"
              class="cap-xs bg-acc px-2.5 py-1 text-white"
            >
              VERIFICANDO...
            </span>
            <span
              id="admin-user-name"
              class="text-[11px] tracking-[0.14em] uppercase text-white/90"
            ></span>
          </div>

          <a
            href="/"
            class="border border-white/30 px-3.5 py-2 text-[10px] tracking-[0.18em] uppercase text-white transition hover:border-white hover:bg-white hover:text-ink"
          >
            Portal Cliente ↗
          </a>

          <button
            id="admin-logout-btn"
            type="button"
            class="cursor-pointer border border-white/25 bg-white/10 px-3.5 py-2 text-[10px] tracking-[0.18em] uppercase text-white transition hover:border-red-500 hover:bg-red-600"
          >
            Salir
          </button>
        </div>
      </div>

      <!-- Barra de Navegación de Módulos Administrativos -->
      <nav class="no-scrollbar border-t border-white/15 bg-[#14142c] overflow-x-auto">
        <div class="mx-auto flex max-w-[1640px] items-center gap-1 px-5 lg:px-9">
          {
            navLinks.map((item) => {
              const active = section === item.id;
              return (
                <a
                  href={item.href}
                  data-admin-module={item.id}
                  class={`flex items-center gap-2.5 whitespace-nowrap border-b-2 px-4 py-3.5 text-[10px] tracking-[0.2em] uppercase transition ${
                    active
                      ? "border-acc bg-white/10 text-white font-medium"
                      : "border-transparent text-white/65 hover:text-white hover:bg-white/5"
                  }`}
                >
                  <span class="note text-acclite">{item.note}</span>
                  <span>{item.label}</span>
                </a>
              );
            })
          }
        </div>
      </nav>
    </header>

    <!-- ── Contenedor Principal Protegido por Guard de Rol ── -->
    <div
      id="admin-guard-loading"
      class="mx-auto max-w-[1640px] px-5 py-24 text-center lg:px-9"
    >
      <div class="cap-xs mb-2 text-acc">SEGURIDAD RBAC</div>
      <p class="text-[13px] tracking-[0.06em] text-soft">
        Verificando credenciales de administrador...
      </p>
    </div>

    <main
      id="admin-main-slot"
      class="mx-auto hidden max-w-[1640px] px-5 pb-24 pt-10 lg:px-9"
    >
      <slot />
    </main>

    <!-- ── Toast Administrativo Global ── -->
    <div
      id="admin-toast"
      class="pointer-events-none fixed bottom-6 right-6 z-[350] translate-y-2 opacity-0 transition-all duration-300"
    >
      <div
        id="admin-toast-text"
        class="cap-tag border border-ink bg-[#191936] px-5 py-3.5 text-white shadow-lg"
      ></div>
    </div>

    <script>
      import { AuthApi } from "../api/services/auth/AuthApi";
      import { isAdminOrRh, isStrictAdmin } from "../lib/authGuard";

      const authApi = new AuthApi();
      const guardLoading = document.getElementById("admin-guard-loading");
      const mainSlot = document.getElementById("admin-main-slot");
      const userNameEl = document.getElementById("admin-user-name");
      const userRoleEl = document.getElementById("admin-user-role");
      const logoutBtn = document.getElementById("admin-logout-btn");

      // Exponer helper global de notificación para las páginas de Admin
      let toastTimer: ReturnType<typeof setTimeout>;
      (window as any).adminToast = (msg: string) => {
        const box = document.getElementById("admin-toast");
        const txt = document.getElementById("admin-toast-text");
        if (!box || !txt) return;
        txt.textContent = msg;
        box.classList.remove("opacity-0", "translate-y-2");
        box.classList.add("opacity-100", "translate-y-0");
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          box.classList.add("opacity-0", "translate-y-2");
          box.classList.remove("opacity-100", "translate-y-0");
        }, 2800);
      };

      async function verifyAdminAccess() {
        try {
          const me = await authApi.me();
          if (!me || !isAdminOrRh(me.roles)) {
            window.location.href = "/user/Login?redirect=" + encodeURIComponent(location.pathname);
            return;
          }

          localStorage.setItem("auth_user", JSON.stringify(me));
          if (userNameEl) userNameEl.textContent = me.username;
          if (userRoleEl) {
            userRoleEl.textContent = isStrictAdmin(me.roles) ? "ADMIN" : "RH";
          }

          guardLoading?.classList.add("hidden");
          mainSlot?.classList.remove("hidden");
        } catch {
          localStorage.removeItem("auth_user");
          window.location.href = "/user/Login?redirect=" + encodeURIComponent(location.pathname);
        }
      }

      logoutBtn?.addEventListener("click", async () => {
        try {
          await authApi.logout();
        } catch {
          // Ignorar error de red
        }
        localStorage.removeItem("auth_user");
        window.location.href = "/user/Login";
      });

      verifyAdminAccess();
    </script>
  </body>
</html>


---
export interface Props {
    href: string;
    text: string;
    icon?:
        | "store"
        | "user"
        | "overview"
        | "shop"
        | "about"
        | "signin"
        | "settings"
        | "default";
    label?: string;
    isActive?: boolean;
}

const { href, text, label, icon = "default", isActive = false } = Astro.props;
---

<a
    href={href}
    class:list={[
        "inline-flex items-center gap-2 px-3 py-2 rounded-lg text-sm transition-all duration-200 group relative",
        isActive
            ? "text-[#ff2638] bg-red-500/10 dark:bg-red-500/15 font-semibold"
            : "text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white hover:bg-slate-100/80 dark:hover:bg-slate-800/60 font-medium",
    ]}
    {...label && { "aria-label": label }}
    aria-current={isActive ? "page" : undefined}
>
    <span
        class:list={[
            "size-4 shrink-0 transition-transform duration-200 group-hover:scale-110 inline-flex items-center justify-center",
            isActive ? "text-[#ff2638]" : "text-slate-400 group-hover:text-slate-700 dark:group-hover:text-slate-200",
        ]}
    >
        {
            icon === "overview" && (
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <rect x="3" y="3" width="7" height="7" rx="1" />
                    <rect x="14" y="3" width="7" height="7" rx="1" />
                    <rect x="14" y="14" width="7" height="7" rx="1" />
                    <rect x="3" y="14" width="7" height="7" rx="1" />
                </svg>
            )
        }
        {
            (icon === "shop" || icon === "store") && (
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
                    <line x1="3" y1="6" x2="21" y2="6" />
                    <path d="M16 10a4 4 0 0 1-8 0" />
                </svg>
            )
        }
        {
            icon === "about" && (
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="16" x2="12" y2="12" />
                    <line x1="12" y1="8" x2="12.01" y2="8" />
                </svg>
            )
        }
        {
            (icon === "signin" || icon === "user") && (
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                    <polyline points="10 17 15 12 10 7" />
                    <line x1="15" y1="12" x2="3" y2="12" />
                </svg>
            )
        }
        {
            icon === "default" && (
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <circle cx="12" cy="12" r="10" />
                </svg>
            )
        }
    </span>
    <span>{text}</span>
</a>

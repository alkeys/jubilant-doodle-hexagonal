---
// src/pages/user/register.astro
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import { ProductosApi } from "../../api/services/productos/ProductosApi";
import type { ProductoResponse } from "../../api/types/productos/ProductoResponse";

const productosApi = new ProductosApi();
let productoEditorial: ProductoResponse | null = null;

try {
  const principales = await productosApi.getPrincipalesProductos(0, 4);
  productoEditorial = principales[1] ?? principales[0] ?? null;
} catch (e) {
  console.error("Error al cargar imagen editorial en Registro:", e);
}

const imgEditorial =
  productoEditorial?.imagenes?.find((img) => img.esPrincipal)?.url ||
  productoEditorial?.imagenes?.[0]?.url ||
  "";
---

<Layout title="Crear Cuenta — NOBLE MUSE" heroHeader={false}>
  <main class="mx-auto max-w-[1640px] px-5 pb-24 pt-28 sm:pt-36 lg:px-9">
    <!-- Migas de pan estilo Noble Muse -->
    <div class="mb-8 flex items-center justify-between border-b border-line pb-4">
      <div class="cap-xs text-muted">
        <a href="/" class="hover:text-ink transition">INICIO</a>
        <span class="mx-2">/</span>
        <a href="/user/Login" class="hover:text-ink transition">CUENTA</a>
        <span class="mx-2">/</span>
        <span class="text-ink">REGISTRO</span>
      </div>
      <span class="note text-muted">post /api/v1/usuarios · rol cliente</span>
    </div>

    <!-- Grid Editorial de 2 Columnas (Sin bordes redondeados, ángulos rectos) -->
    <div class="grid grid-cols-1 border border-line bg-white lg:grid-cols-12">
      <!-- ── Columna Izquierda: Editorial / Imagen de Campaña desde la API ── -->
      <aside class="relative hidden flex-col justify-between overflow-hidden bg-[#191936] p-12 text-white lg:col-span-5 lg:flex min-h-[720px]">
        {
          imgEditorial && (
            <img
              src={imgEditorial}
              alt={productoEditorial?.nombre ?? "Noble Muse Editorial"}
              class="absolute inset-0 h-full w-full object-cover opacity-55 transition-transform duration-[1400ms] hover:scale-[1.03]"
            />
          )
        }
        <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/45 to-ink/30"></div>

        <!-- Encabezado Editorial Superior -->
        <div class="relative z-10 flex items-center justify-between">
          <span class="cap-xs tracking-[0.28em] text-white/85">
            NOBLE MUSE · CLUB
          </span>
          {
            productoEditorial && (
              <span class="note text-white/75">
                colección · {productoEditorial.nombre.toLowerCase()}
              </span>
            )
          }
        </div>

        <!-- Texto Central / Inferior de Campaña -->
        <div class="relative z-10 flex flex-col gap-6">
          <div class="cap-xs text-acclite">NUEVO MIEMBRO</div>
          <h2 class="m-0 max-w-[16ch] text-[clamp(26px,2.4vw,36px)] font-normal leading-[1.18] tracking-[0.18em]">
            CREA TU PERFIL EN NOBLE MUSE
          </h2>
          <p class="m-0 max-w-[40ch] text-[12.5px] leading-[1.8] tracking-[0.04em] text-white/80">
            Al registrarte obtienes acceso inmediato a tu perfil de cliente,
            seguimiento de disponibilidad por sucursal y sincronización de tu
            bolsa de compra.
          </p>

          <div class="flex flex-col gap-3 border-t border-white/20 pt-6 text-[11px] text-white/80">
            <div class="flex items-center justify-between">
              <span class="cap-xs text-acclite">ROL ASIGNADO</span>
              <span class="note">CLIENTE</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="cap-xs text-acclite">COBERTURA</span>
              <span class="note">TODAS LAS SUCURSALES</span>
            </div>
          </div>
        </div>
      </aside>

      <!-- ── Columna Derecha: Formulario de Registro (/api/v1/usuarios) ── -->
      <section class="flex flex-col justify-center px-6 py-12 sm:px-14 lg:col-span-7 lg:px-20 lg:py-16">
        <div class="mx-auto w-full max-w-[540px]">
          <!-- Encabezado del Formulario -->
          <div class="mb-9">
            <div class="cap-xs mb-2.5 text-acc">REGISTRO DE CLIENTE</div>
            <h1 class="m-0 text-[26px] font-normal tracking-[0.22em] text-ink">
              CREAR CUENTA NUEVA
            </h1>
            <p class="mt-3 text-[12.5px] leading-relaxed tracking-[0.03em] text-soft">
              Completa tus datos personales para registrar tu cuenta en nuestra
              plataforma multitienda.
            </p>
          </div>

          <form id="register-form" class="flex flex-col gap-6">
            <!-- Fila 1: Nombre y Apellido -->
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div class="flex flex-col gap-2">
                <div class="flex items-center justify-between">
                  <label for="nombre" class="cap-xs text-ink">NOMBRE</label>
                  <span class="note text-muted">requerido</span>
                </div>
                <input
                  id="nombre"
                  name="nombre"
                  type="text"
                  required
                  placeholder="ej. Juan Carlos"
                  class="w-full border border-line bg-tint/20 px-4 py-3.5 text-[13px] tracking-[0.04em] text-ink outline-none transition placeholder:text-muted focus:border-ink focus:bg-white"
                />
              </div>

              <div class="flex flex-col gap-2">
                <div class="flex items-center justify-between">
                  <label for="apellido" class="cap-xs text-ink">APELLIDO</label>
                  <span class="note text-muted">requerido</span>
                </div>
                <input
                  id="apellido"
                  name="apellido"
                  type="text"
                  required
                  placeholder="ej. Aviles"
                  class="w-full border border-line bg-tint/20 px-4 py-3.5 text-[13px] tracking-[0.04em] text-ink outline-none transition placeholder:text-muted focus:border-ink focus:bg-white"
                />
              </div>
            </div>

            <!-- Fila 2: Nombre de Usuario y Edad -->
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
              <div class="flex flex-col gap-2 sm:col-span-2">
                <div class="flex items-center justify-between">
                  <label for="nombreDeUsuario" class="cap-xs text-ink">
                    NOMBRE DE USUARIO
                  </label>
                  <span class="note text-muted">único</span>
                </div>
                <input
                  id="nombreDeUsuario"
                  name="nombreDeUsuario"
                  type="text"
                  required
                  autocomplete="username"
                  placeholder="ej. juanaviles"
                  class="w-full border border-line bg-tint/20 px-4 py-3.5 text-[13px] tracking-[0.04em] text-ink outline-none transition placeholder:text-muted focus:border-ink focus:bg-white"
                />
              </div>

              <div class="flex flex-col gap-2">
                <div class="flex items-center justify-between">
                  <label for="edad" class="cap-xs text-ink">EDAD</label>
                  <span class="note text-muted">años</span>
                </div>
                <input
                  id="edad"
                  name="edad"
                  type="number"
                  min="0"
                  max="120"
                  required
                  placeholder="25"
                  class="w-full border border-line bg-tint/20 px-4 py-3.5 text-[13px] tracking-[0.04em] text-ink outline-none transition placeholder:text-muted focus:border-ink focus:bg-white"
                />
              </div>
            </div>

            <!-- Fila 3: Correo Electrónico -->
            <div class="flex flex-col gap-2">
              <div class="flex items-center justify-between">
                <label for="email" class="cap-xs text-ink">
                  CORREO ELECTRÓNICO
                </label>
                <span class="note text-muted">requerido</span>
              </div>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="ej. juan.aviles@correo.com"
                class="w-full border border-line bg-tint/20 px-4 py-3.5 text-[13px] tracking-[0.04em] text-ink outline-none transition placeholder:text-muted focus:border-ink focus:bg-white"
              />
            </div>

            <!-- Fila 4: Contraseña y Confirmación -->
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div class="flex flex-col gap-2">
                <div class="flex items-center justify-between">
                  <label for="password" class="cap-xs text-ink">
                    CONTRASEÑA
                  </label>
                  <button
                    type="button"
                    id="toggle-reg-pwd"
                    class="note cursor-pointer text-muted hover:text-ink"
                  >
                    mostrar
                  </button>
                </div>
                <input
                  id="password"
                  name="password"
                  type="password"
                  required
                  minlength="4"
                  autocomplete="new-password"
                  placeholder="••••••••"
                  class="w-full border border-line bg-tint/20 px-4 py-3.5 text-[13px] tracking-[0.08em] text-ink outline-none transition placeholder:text-muted focus:border-ink focus:bg-white"
                />
              </div>

              <div class="flex flex-col gap-2">
                <div class="flex items-center justify-between">
                  <label for="confirmPassword" class="cap-xs text-ink">
                    CONFIRMAR CONTRASEÑA
                  </label>
                </div>
                <input
                  id="confirmPassword"
                  name="confirmPassword"
                  type="password"
                  required
                  minlength="4"
                  autocomplete="new-password"
                  placeholder="••••••••"
                  class="w-full border border-line bg-tint/20 px-4 py-3.5 text-[13px] tracking-[0.08em] text-ink outline-none transition placeholder:text-muted focus:border-ink focus:bg-white"
                />
              </div>
            </div>

            <!-- Alerta de Estado (Error / Éxito) -->
            <div
              id="register-msg"
              class="hidden border px-4 py-3 text-[11.5px] tracking-[0.05em]"
            ></div>

            <!-- Botones de Acción -->
            <div class="flex flex-col gap-3 pt-2 sm:flex-row">
              <button
                id="register-btn"
                type="submit"
                class="btn-ink flex-1 py-4"
              >
                Completar registro
              </button>
              <a
                href="/user/Login"
                class="btn-ghost flex items-center justify-center px-6 py-4 text-center text-ink"
              >
                Ya tengo cuenta
              </a>
            </div>
          </form>

          <!-- Pie del Formulario -->
          <div class="mt-10 flex items-center justify-between border-t border-line pt-6">
            <a
              href="/user/Login"
              class="cap link-u text-soft hover:text-ink"
              style="letter-spacing:.18em"
            >
              ← Volver a Iniciar Sesión
            </a>
            <a
              href="/"
              class="cap text-muted hover:text-ink"
              style="letter-spacing:.16em"
            >
              Ir al catálogo
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  import { UsuariosApi } from "../../api/services/usuarios/UsuariosApi";
  import { AuthApi } from "../../api/services/auth/AuthApi";
  import type { UsuarioRequest } from "../../api/types/usuarios/UsuarioRequest";

  const usuariosApi = new UsuariosApi();
  const authApi = new AuthApi();

  const form = document.getElementById("register-form") as HTMLFormElement | null;
  const nombreInput = document.getElementById("nombre") as HTMLInputElement | null;
  const apellidoInput = document.getElementById("apellido") as HTMLInputElement | null;
  const usernameInput = document.getElementById("nombreDeUsuario") as HTMLInputElement | null;
  const edadInput = document.getElementById("edad") as HTMLInputElement | null;
  const emailInput = document.getElementById("email") as HTMLInputElement | null;
  const passwordInput = document.getElementById("password") as HTMLInputElement | null;
  const confirmInput = document.getElementById("confirmPassword") as HTMLInputElement | null;
  const togglePwdBtn = document.getElementById("toggle-reg-pwd");
  const msgEl = document.getElementById("register-msg");
  const submitBtn = document.getElementById("register-btn") as HTMLButtonElement | null;

  function showMessage(text: string, type: "error" | "success") {
    if (!msgEl) return;
    msgEl.textContent = text;
    msgEl.classList.remove(
      "hidden",
      "border-red-400",
      "bg-red-50/60",
      "text-red-800",
      "border-acc",
      "bg-tint",
      "text-ink"
    );
    if (type === "error") {
      msgEl.classList.add("border-red-400", "bg-red-50/60", "text-red-800");
    } else {
      msgEl.classList.add("border-acc", "bg-tint", "text-ink");
    }
  }

  // Mostrar / ocultar contraseñas
  togglePwdBtn?.addEventListener("click", () => {
    if (!passwordInput || !confirmInput) return;
    const isPassword = passwordInput.type === "password";
    passwordInput.type = isPassword ? "text" : "password";
    confirmInput.type = isPassword ? "text" : "password";
    togglePwdBtn.textContent = isPassword ? "ocultar" : "mostrar";
  });

  // Enviar registro a POST /api/v1/usuarios
  form?.addEventListener("submit", async (event: SubmitEvent) => {
    event.preventDefault();

    const nombre = nombreInput?.value.trim() ?? "";
    const apellido = apellidoInput?.value.trim() ?? "";
    const nombreDeUsuario = usernameInput?.value.trim() ?? "";
    const edad = Number(edadInput?.value ?? 0);
    const email = emailInput?.value.trim() ?? "";
    const password = passwordInput?.value ?? "";
    const confirmPassword = confirmInput?.value ?? "";

    if (password !== confirmPassword) {
      showMessage("LAS CONTRASEÑAS NO COINCIDEN. VERIFÍCALAS.", "error");
      return;
    }

    if (edad < 0 || Number.isNaN(edad)) {
      showMessage("INGRESA UNA EDAD VÁLIDA.", "error");
      return;
    }

    const payload: UsuarioRequest = {
      nombre,
      apellido,
      email,
      edad,
      nombreDeUsuario,
      password,
    };

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "REGISTRANDO CUENTA...";
    }
    msgEl?.classList.add("hidden");

    try {
      // 1. Crear el usuario mediante POST /api/v1/usuarios
      const usuarioCreado = await usuariosApi.createUser(payload);

      // 2. Iniciar sesión automáticamente para que entre directo a su cuenta
      try {
        const authRes = await authApi.login({
          username: payload.nombreDeUsuario,
          password: payload.password,
        });
        localStorage.setItem("auth_user", JSON.stringify(authRes));
        if (authRes.token) {
          localStorage.setItem("auth_token", authRes.token);
        }

        showMessage(
          `¡CUENTA CREADA EXITOSAMENTE PARA ${usuarioCreado.nombre.toUpperCase()}! ENTRANDO A TU PERFIL...`,
          "success"
        );

        setTimeout(() => {
          window.location.href = "/user/account";
        }, 800);
      } catch {
        // Si por alguna razón requiere login manual, redirigir a /user/Login
        showMessage(
          "¡CUENTA CREADA EXITOSAMENTE! REDIRIGIENDO A INICIAR SESIÓN...",
          "success"
        );
        setTimeout(() => {
          window.location.href = "/user/Login";
        }, 900);
      }
    } catch (error: any) {
      let apiMsg = "";
      if (!error?.response) {
        apiMsg =
          "NO SE PUDO CONECTAR CON EL SERVIDOR (http://localhost:8080). VERIFICA QUE EL BACKEND ESTÉ EN EJECUCIÓN.";
      } else if (
        error.response.data?.validationErrors &&
        typeof error.response.data.validationErrors === "object"
      ) {
        apiMsg = Object.values(error.response.data.validationErrors).join(" · ");
      } else {
        apiMsg =
          error.response.data?.message ||
          error.response.data?.mensaje ||
          error.response.data?.error ||
          "NO SE PUDO COMPLETAR EL REGISTRO. VERIFICA SI EL USUARIO O EMAIL YA ESTÁN EN USO.";
      }
      showMessage(String(apiMsg).toUpperCase(), "error");

      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Completar registro";
      }
    }
  });
</script>


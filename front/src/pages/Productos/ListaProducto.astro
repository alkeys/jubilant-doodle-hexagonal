---
// src/pages/Productos/ListaProducto.astro
import { ProductosApi } from "../../api/services/productos/ProductosApi";
import { CategoriasApi } from "../../api/services/categorias/CategoriasApi";
import { TiendasApi } from "../../api/services/tiendas/TiendasApi";
import { VentasApi } from "../../api/services/ventas/VentasApi";
import type { ProductoResponse } from "../../api/types/productos/ProductoResponse";
import type { CategoriaResponse } from "../../api/types/categorias/CategoriaResponse";
import type { TiendaResponse } from "../../api/types/tiendas/TiendaResponse";
import type { ProductoMasVendidoResponse } from "../../api/types/ventas/ProductoMasVendidoResponse";

// Componentes Modulares del Home
import HeroSlider from "../../components/home/HeroSlider.astro";
import CategoriasGrid from "../../components/home/CategoriasGrid.astro";
import CatalogoFiltros from "../../components/home/CatalogoFiltros.astro";
import ProductoCard from "../../components/home/ProductoCard.astro";
import TopVentasSection from "../../components/home/TopVentasSection.astro";
import SucursalesSection from "../../components/home/SucursalesSection.astro";

const productosApi = new ProductosApi();
const categoriasApi = new CategoriasApi();
const tiendasApi = new TiendasApi();
const ventasApi = new VentasApi();

let productos: ProductoResponse[] = [];
let categorias: CategoriaResponse[] = [];
let tiendas: TiendaResponse[] = [];
let topVendidos: ProductoMasVendidoResponse[] = [];

try {
  [productos, categorias, tiendas, topVendidos] = await Promise.all([
    productosApi.getPrincipalesProductos(0, 50),
    categoriasApi.listCategorias(),
    tiendasApi.listTiendasActivas(),
    ventasApi.getProductosMasVendidos(4).catch(() => []),
  ]);
} catch (error) {
  console.error("Error al obtener datos del Home desde la API:", error);
}

// Mapa rápido de categorías por ID
const categoriaMap = new Map(categorias.map((c) => [c.id, c.nombre]));

// Tallas únicas extraídas de los productos reales
const tallasUnicas = Array.from(
  new Set(
    productos.flatMap((p) =>
      (p.talla ?? "")
        .split(",")
        .map((s) => s.trim())
        .filter(Boolean)
    )
  )
);

// Precio máximo dinámico para el slider de filtro
const maxPrecioCatalogo = Math.ceil(
  Math.max(
    150,
    ...productos.map((p) => p.precioMax ?? p.precioMin ?? p.precio ?? 0)
  )
);

// Slides del Hero con los primeros productos de la API
const heroProductos = productos.slice(0, 3);

// Tarjetas de categorías con una imagen representativa de algún producto de esa categoría
const categoriasConImagen = categorias.map((cat) => {
  const prodCategoria = productos.find((p) => p.categoriaId === cat.id);
  const img =
    prodCategoria?.imagenes?.find((im) => im.esPrincipal) ||
    prodCategoria?.imagenes?.[0];
  const cantidad = productos.filter((p) => p.categoriaId === cat.id).length;
  return {
    ...cat,
    imagenUrl: img?.url ?? "",
    cantidad,
  };
});

// Cruzar los productos más vendidos con su ficha completa del catálogo
const topProductosDetalle = topVendidos
  .map((tv) => {
    const prod = productos.find((p) => p.id === tv.productoId);
    return prod ? { ...tv, producto: prod } : null;
  })
  .filter((item): item is NonNullable<typeof item> => item !== null);
---

<!-- 1. Hero Slider Dinámico -->
<HeroSlider heroProductos={heroProductos} categoriaMap={categoriaMap} />

<!-- 2. Mosaico de Categorías / Colecciones -->
<CategoriasGrid
  categoriasConImagen={categoriasConImagen}
  totalProductos={productos.length}
/>

<!-- 3. Catálogo Completo con Filtros y Grilla de Productos -->
<section
  id="catalogo"
  class="mx-auto max-w-[1640px] scroll-mt-24 px-5 pt-24 lg:px-9"
>
  <div
    class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end"
  >
    <div>
      <div class="cap-xs mb-2 text-muted" data-catalog-crumb>
        INICIO / CATÁLOGO COMPLETO
      </div>
      <h1
        class="m-0 text-[26px] font-normal tracking-[0.2em]"
        data-catalog-title
      >
        NUESTROS PRODUCTOS
      </h1>
    </div>
    <div class="flex items-center gap-4">
      <button
        type="button"
        data-f-reset
        class="cap-xs link-u hidden cursor-pointer text-acc"
      >
        Limpiar filtros
      </button>
      <div
        class="text-[11px] tracking-[0.08em] text-soft"
        data-catalog-count
      >
        {productos.length} piezas disponibles
      </div>
    </div>
  </div>

  <!-- Barra de Filtros Interactivos -->
  <CatalogoFiltros
    tiendas={tiendas}
    categorias={categorias}
    tallasUnicas={tallasUnicas}
    maxPrecioCatalogo={maxPrecioCatalogo}
  />

  <!-- Mensaje cuando no hay coincidencias -->
  <div data-empty-grid class="cap-tag hidden py-20 text-center text-muted">
    No hay productos que coincidan con los filtros seleccionados.
  </div>

  <!-- Grilla de Tarjetas de Producto -->
  <div
    data-products-grid
    class="grid grid-cols-1 gap-x-5 gap-y-12 sm:grid-cols-2 lg:grid-cols-4"
  >
    {
      productos.map((producto, index) => (
        <ProductoCard
          producto={producto}
          index={index}
          categoriaNombre={categoriaMap.get(producto.categoriaId) ?? "Catálogo"}
        />
      ))
    }
  </div>
</section>

<!-- 4. Ranking de Más Vendidos -->
<TopVentasSection topProductosDetalle={topProductosDetalle} />

<!-- 5. Directorio de Sucursales -->
<SucursalesSection tiendas={tiendas} productos={productos} />

<script>
  import { initCatalogFilters } from "../../lib/catalogFilterClient";
  initCatalogFilters();
</script>

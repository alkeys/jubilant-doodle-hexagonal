---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Pagina no encontrada">
    <div
        class="bg-slate-950 text-white min-h-screen flex items-center justify-center overflow-hidden relative font-sans"
    >
        <!-- Blur radiales de fondo (Violeta, Azul y Rojo) -->
        <div
            class="absolute -top-32 -left-32 w-96 h-96 bg-violet-600/30 rounded-full blur-3xl pointer-events-none animate-pulse"
        >
        </div>
        <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-blue-600/20 rounded-full blur-3xl pointer-events-none"
        >
        </div>
        <div
            class="absolute -bottom-32 -right-32 w-96 h-96 bg-red-600/30 rounded-full blur-3xl pointer-events-none animate-pulse"
        >
        </div>

        <!-- Contenido principal -->
        <main
            class="relative z-10 text-center px-6 max-w-2xl mx-auto flex flex-col items-center"
        >
            <!-- Número 404 con degradado Violeta -> Azul -> Rojo -->
            <h1
                class="text-8xl sm:text-9xl font-black tracking-tight bg-gradient-to-r from-violet-500 via-blue-500 to-red-500 bg-clip-text text-transparent select-none drop-shadow-[0_10px_35px_rgba(139,92,246,0.3)]"
            >
                404
            </h1>

            <!-- Divisor con degradado -->
            <div
                class="h-1 w-24 my-6 bg-gradient-to-r from-violet-500 via-blue-500 to-red-500 rounded-full"
            >
            </div>

            <h2 class="text-2xl sm:text-3xl font-bold text-slate-100 mb-3">
                Página no encontrada
            </h2>

            <p class="text-slate-400 text-base sm:text-lg mb-8 max-w-md">
                Lo sentimos, la ruta que estás intentando consultar no existe o
                ha sido movida.
            </p>

            <!-- Botón con hover interactivo y degradado en bordes/fondo -->
            <a
                href="/"
                class="group relative inline-flex items-center gap-2 px-8 py-3.5 rounded-full font-semibold text-white bg-slate-900 border border-slate-800 transition-all duration-300 hover:scale-105 hover:border-transparent focus:outline-none focus:ring-2 focus:ring-violet-500/50"
            >
                <span
                    class="absolute inset-0 rounded-full bg-gradient-to-r from-violet-600 via-blue-600 to-red-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300 -z-10 blur-sm"
                ></span>
                <span
                    class="absolute inset-0 rounded-full bg-gradient-to-r from-violet-600 via-blue-600 to-red-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300 -z-10"
                ></span>

                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-5 h-5 transition-transform group-hover:-translate-x-1"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="m12 19-7-7 7-7"></path>
                    <path d="M19 12H5"></path>
                </svg>
                <span>Volver al inicio</span>
            </a>
        </main>
    </div>
</Layout>
